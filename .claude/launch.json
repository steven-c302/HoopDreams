{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hoopdreams-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "partyos-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home; exec tv/devserver/build/install/devserver/bin/devserver --port 8080 --pin 4242 --static controller/dist"
      ],
      "port": 8080,
      "url": "http://127.0.0.1:8080"
    }
  ]
}